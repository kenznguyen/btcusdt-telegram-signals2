{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "btcusdt-entry-backtest-only",
  "dry_run": true,
  "dry_run_wallet": 100,
  "trading_mode": "spot",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 1,
  "cancel_open_orders_on_exit": false,
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "dataformat_ohlcv": "feather",
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false
  }
}

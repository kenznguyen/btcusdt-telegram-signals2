{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "btc-freqai-research-backtest-only",
  "dry_run": true,
  "dry_run_wallet": 100,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 1,
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "dataformat_ohlcv": "feather",
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false
  },
  "freqai": {
    "enabled": true,
    "identifier": "btc-m15-h1-lgbm-research-v1",
    "train_period_days": 45,
    "backtest_period_days": 15,
    "purge_old_models": 2,
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 4,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [
        14,
        20
      ]
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 100,
      "learning_rate": 0.05,
      "num_leaves": 15,
      "verbosity": -1
    },
    "activate_tensorboard": false
  }
}
